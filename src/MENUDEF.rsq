// RS VR hands / reload / ballistics (zscript/rsq, zscript/rsr). v9.
// Nothing here changes the engine's two-hand grip (vr_two_handed_weapons): its row only names it.
//
// NO StaticText help in here, deliberately and by owner's instruction (asked twice). An
// options menu is a list of options. How the reload works is documented in the repo:
// LOAD_ORDER.md and docs/RELOAD_ON_QUEST.md in presidentkoopa/RS_Quest.
AddOptionMenu "OptionsMenu"
{
	Submenu "BD22 VR Weapons", "RSQ_Options"
}

AddOptionMenu "BrutalMenu"
{
	StaticText " "
	Submenu "BD22 VR Weapons", "RSQ_Options"
}

OptionValue "RSR_ReloadMode"
{
	1, "VR"
	0, "Stock (BD22)"
}

OptionValue "RSR_GrabWith"
{
	0, "Off-hand trigger"
	1, "Off-hand grip"
	2, "Use key"
}

OptionValue "RSQ_Ballistics"
{
	0, "Stock (BD22)"
	1, "Low"
	2, "Max"
}

OptionValue "RSR_Pouch"
{
	0, "Anywhere, 20 cm from the gun"
	1, "Low, 40 cm below the eyes"
}

// 2026-10-23: the VR scopes (zscript/rsq/scope.zs), per gun
OptionValue "RSQ_ScopeMode"
{
	0, "Dot (1x)"
	1, "Real (3x)"
}

OptionValue "RSR_ShellCredit"
{
	1, "1"
	2, "2"
	3, "3"
	4, "4"
}

OptionMenu "RSQ_Options"
{
	Title "BD22 VR WEAPONS"
	Option "VR Hands", "rsq_hands", "OnOff"
	Option "Hand Skin Tone", "rsq_hand_tone", "RSQ_HandTone"	// BD 2.0: zscript/rsq/handtone.zs
	Option "Reloading", "rsr_reload", "RSR_ReloadMode"
	Option "Reload Non-Standard Guns", "rsq_reload_nonstd", "OnOff"
	Option "Grab ammo with", "rsr_grab_with", "RSR_GrabWith"
	Option "New magazine from", "rsr_pouch", "RSR_Pouch"
	Option "Ammo From the Rig's Pouch Only", "rsr_rig_pouch", "OnOff"
	Option "Shotgun Shells Per Insert", "rsr_shell_credit", "RSR_ShellCredit"
	Slider "Reload assist", "rsr_assist", 0.5, 3.0, 0.1
	Option "Pistol Semi Auto", "rsa_pistol_semi", "OnOff"
	Option "Shotgun Slugshot Alt Fire", "rsa_sg_slug", "OnOff"
	Option "Assault Shotgun Slugshot Alt Fire", "rsa_asg_slug", "OnOff"
	Option "Rocket Launcher Lock-On Alt Fire", "rsa_rl_lock", "OnOff"
	Option "Shotvolver Slugshot Alt Fire", "rsa_rev_slug", "OnOff"
	Option "Shot/Revolver Reload", "rsb_revolver_feed", "RSB_RevFeed"
	Option "Rifle Underbarrel Ammo", "rsm_ammo", "RSM_Ammo"
	Option "Machinegun replaces MG42", "rsq_mg_replaces_mg42", "OnOff"
	Option "Silvergun Replaces Pistol", "rsq_moonlight_pistol", "OnOff"
	Option "Start With Two Silverguns", "rsq_moonlight_two", "OnOff"
	Option "HUD Ammo", "rsq_hud_ammo", "RSQ_HudAmmo"
	Option "Sniper Scope", "rsq_scope2_sniper", "RSQ_ScopeMode"
	Option "Railgun Scope", "rsq_scope2_railgun", "RSQ_ScopeMode"
	Option "Ballistics", "rsq_ballistics", "RSQ_Ballistics"
	Option "True Bullets", "sv_rsq_true_bullets", "OnOff"	// 2.0.2 (owner r3 item 39): On = flying rounds with the Dakka look (playerrounds.zs, shotfx.zs); Off = stock BD22 hitscan and tracers
	Option "Pump Shotgun Spread", "rsq_pump_spread", "RSQ_PumpSpread"	// BD 2.0: actors/Weapons/Shotgun.dec
	StaticText " "
	Submenu "Voxel Options", "RSQ_VoxelOptions"
	StaticText " "
	Submenu "Dual Options", "RSQ_DualOptions"
	Option "Dual Flick to Reload", "rsq_flick", "OnOff"
	StaticText " "
	Option "VR Throwing", "rsg_vr", "OnOff"
	Option "Use RSQ Grenade Instead", "rsg_rsq_nade", "OnOff"	// 2.0.3y (owner item 21): with RSQ Grenade loaded, this grenade stands down (rsg/grenade.zs)
	Option "Pin With Your Teeth", "rsg_face", "OnOff"	// 2.0.3p: RSQ Grenade's teeth pull (zscript/rsg/grenade.zs Face); the off-hand ring works either way
	Slider "Teeth: Mouth Reach (m)", "rsg_mouth_r", 0.05, 0.30, 0.01, 2	// 2.0.3r: round the mouth (lips to under the chin), from the headset
	Slider "Teeth: Again Beyond (m)", "rsg_face_far", 0.30, 1.50, 0.01, 2
	Slider "Teeth: Hold (tics)", "rsg_face_hold", 2, 40, 1, 0
	Option "Shoot Thrown Grenades", "rsg_shoot", "OnOff"	// 2.0.3r: zscript/rsg/grenade.zs RSG_Handler
	Slider "Shot Grenade Reach (m)", "rsg_shot_r", 0.10, 0.35, 0.01, 2	// 2.0.3t: tightens only
	Option "Only in Slow Motion", "rsg_shoot_slowmo", "OnOff"
	Option "Faster Grenades in Slow Motion", "rsg_slowmo_fast", "OnOff"
	Slider "Grenade Speed in Slow Motion", "rsg_slowmo_speed", 0.0, 1.0, 0.05, 2
	Option "Two-Hand Grip (engine)", "vr_two_handed_weapons", "OnOff"	// 2.0.2: QuestZDoom's own two-hand cvar, unchanged; the row only says so
	Option "VR Punching", "rsq_punch", "OnOff"
	Option "No Trigger Punch", "rsq_no_trigger_punch", "OnOff"	// 2.0.3y (owner 11-06, on): BD22's fists throw no canned punch on trigger / alt fire in VR; grabs, throws and fatalities unchanged
	Option "Punch Switches Open", "rsq_punch_use", "OnOff"
	Option "Pistol Whip", "rsq_pistol_whip", "OnOff"	// 2.0.2 (owner r3 item 39): swing a pistol or revolver into something (zscript/rsvr/melee.zs); the kick-key gun bash is gone
	Slider "Pistol Whip: Swing Needed", "rsq_whip_speed", 2.0, 10.0, 0.5, 1	// 2.0.3g: higher = whip harder (was 3.2)
	Option "Instant Weapon Switch", "rsq_instant_switch", "OnOff"	// 2.0.2a (owner 19:47): no raise / lower (zscript/rsq/switch.zs)
	Option "Lift Doors by Hand", "rsq_door", "OnOff"	// 2.0.3f: from RSQ_DistanceGrab (zscript/rsvr/door.zs)
	Option "Two-Handed Butt Strike", "rsq_butt", "OnOff"
	Slider "Butt Strike: Swing Needed", "rsq_butt_speed", 1.0, 6.0, 0.1, 1	// 2.0.3y (owner item 33): higher = shove harder (was a fixed 3.6)
	Option "Real Casing Models", "rsq_casing_models", "OnOff"
	Slider "Casing Size", "rsq_casing_size", 0.5, 2.5, 0.1, 1
	Option "Melee Hit Flash", "rsq_bash_flash", "OnOff"
	Option "Melee Hit Flash Style", "rsq_bash_fx", "RSQ_BashFXOpt"
	Option "Melee Hit Flash Colour", "rsq_bash_tint", "RSQ_BashTintOpt"
	Slider "Melee swing strength", "rsvr_melee_swing", 0.2, 3.0, 0.1
	StaticText " "
	Option "Extra weapons with cheats", "rsq_extra_weapons", "OnOff"
	StaticText " "
	Submenu "Reload: tuning and debug", "RSR_Debug"
}

OptionMenu "RSR_Debug"
{
	Title "RELOAD: TUNING AND DEBUG"
	Option "Show the capture zones", "rsr_assist_debug", "OnOff"
	Option "Print each reload step", "rsr_debug", "OnOff"
}

// owner 2026-10-27 20:47: what the HUD shows of the held gun's ammo (zscript/rsq/counters.zs RSQ_Counters.Hud)
OptionValue "RSQ_HudAmmo"
{
	0, "Magazine + Reserve"
	1, "Reserve Only"
}

// 1.30 the rifle's M203: what a hand-loaded round costs
OptionValue "RSM_Ammo"
{
	0, "Rockets"
	1, "Hand grenades"
}

OptionValue "RSB_RevFeed"
{
	0, "Speedloader"
	1, "Per Round"
}

OptionValue "RSQ_BashFXOpt"
{
	0, "RSS3"
	1, "RSU1"
	2, "RSU4"
	3, "RSU5"
	4, "RSH0"
}

OptionValue "RSQ_BashTintOpt"
{
	0, "Original"
	1, "Blue"
	2, "Green"
	3, "Amber"
	4, "White"
}
