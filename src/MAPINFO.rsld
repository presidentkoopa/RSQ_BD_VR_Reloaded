// LD mode (zscript/rsld): its handler returns at once when LegenDoom 3.0 is not loaded
gameinfo
{
	AddEventHandlers = "RSLD_Handler", "RSLD_Interface"
	// round 4: QuestZDoom's own menu sounds under "Mute LegenDoom Sounds" (zscript/rsld/ldsounds.zs; without LegenDoom it
	// plays exactly what the engine's DoomMenuDelegate plays)
	MenuDelegateClass = "RSLD_MenuDelegate"
}
