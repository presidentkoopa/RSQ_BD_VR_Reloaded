// RSR-BREAK: the real VR reload for break-open guns and revolvers (zscript/rsr/rsr_break.zs).
// It shares Real reload's options (rsr_reload, rsr_grab_buttons, rsr_magrelease, rsr_pouch, rsr_debug).
user float rsb_flick_speed = 450;	// deg/s: a turn of the gun hand the way the action closes, this fast (over 3 tics), snaps it shut

// 2026-10-16: a double-barrel takes two shells at once when both barrels are empty (0: one at a time)
user int rsr_ssg_pair = 1;

// 2026-10-16: the BD22 shotgun takes a shell at its ejection port too (0: the loading port only)
user int rsr_sideport = 1;

// 2026-10-16: the VR grenade (pin, spoon, cook, throw by swing); 0: BD22's own throw
user int rsg_vr = 1;
// 2.0.3p (owner 2026-11-03): the teeth pin pull, RSQ Grenade's (rsqgn_face*), same defaults (zscript/rsg/grenade.zs Face)
user int rsg_face = 1;			// squeeze the trigger and hold the grenade at your face: the pin is out (0: the ring only)
user float rsg_mouth_r = 0.15;		// 2.0.3r: m the controller, the drawn grenade or its ring may be from your mouth (lips to under the chin, from the headset); replaces rsg_face_near (0.47 m round the pawn's fixed eye)
user float rsg_face_far = 0.71;		// m it must have been clear of your mouth before another
user int rsg_face_hold = 12;		// tics it must stay at your face
// 2.0.3r (owner 2026-11-03 19:43): shoot a thrown grenade and it goes off on the spot (zscript/rsg/grenade.zs RSG_Handler)
server int rsg_shoot = 1;			// a player's shot or projectile within 0.35 m sets off a thrown grenade, 6 tics out of the hand
server float rsg_shot_r = 0.35;		// 2.0.3t: m a shot must pass within to set a thrown grenade off (0.10 to 0.35; never more)
server int rsg_shoot_slowmo = 0;	// ...only while RSQ SlowMo has the world slowed
server int rsg_slowmo_fast = 0;		// in slow motion a thrown grenade runs faster than the world (still slow)
server float rsg_slowmo_speed = 0.5;	// ...this much of the way from the world's speed up to real speed

// 1.97: Shot/Revolver Reload -- 0 the speedloader (as 1.96b shipped), 1 a round at a time
server int rsb_revolver_feed = 0;
