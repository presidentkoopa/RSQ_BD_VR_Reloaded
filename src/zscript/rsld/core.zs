// LD mode (LegenDoom 3.0 x BD22 VR), the foundation: effect base class, shot context, helpers.
// The LD mode is on only when LegenDoom 3.0 is loaded (RSLD.On: its classes are found by name at run time).
// Interface for effect authors: /home/claude/ldmerge/INTERFACE.md (copy in ldl_patch/docs/INTERFACE.md).

class RSLD play
{
	const MAIN = 0;
	const OFF = 1;
	// pellet results (RSLD_Effect.OnPelletEnd)
	const RES_NONE = 0;		// nothing hit (sky, out of range, a round that never arrived)
	const RES_MONSTER = 1;	// damaged a monster
	const RES_THING = 2;	// damaged a non-monster (barrel, decoration)
	const RES_WALL = 3;		// its puff hit a wall / floor / ceiling (LegenDoom's puff Crash state)

	// LegenDoom 3.0 is loaded (DECORATE classes, unknown when ZScript compiles: looked up by name)
	clearscope static bool On()
	{
		string an = "LDLegendaryMonsterToken", bn = "LDPlayer";
		class<Actor> a = an;
		class<Actor> b = bn;
		return a != null && b != null;
	}

	clearscope static int DebugLevel() { cvar c = cvar.FindCvar("rsld_debug"); return c ? c.GetInt() : 0; }
	clearscope static bool Debug() { return DebugLevel() > 0; }
	clearscope static class<Actor> AC(string n) { class<Actor> c = n; return c; }
	clearscope static class<Inventory> IC(string n) { class<Inventory> c = n; return c; }

	static void Log(string s) { if (Debug()) Console.Printf("RSLD %d %s", level.maptime, s); }

	static bool Give(Actor a, string n, int amt = 1)
	{
		class<Inventory> c = n;
		if (!a || !c) return false;
		return a.GiveInventory(c, amt);
	}

	static int Has(Actor a, string n)
	{
		class<Inventory> c = n;
		return (a && c) ? a.CountInv(c) : 0;
	}

	static void AddAmmo(Inventory a, int n)
	{
		if (a && n > 0) a.Amount = min(a.Amount + n, max(a.MaxAmount, a.Amount));
	}

	static RSLD_Handler H() { return RSLD_Handler(EventHandler.Find("RSLD_Handler")); }

	// LegenDoom numbers (numbers_*.zs, generated by ldl_patch/tools/gen_ld_numbers.py)
	static double Num(string eff, string key)
	{
		let h = H();
		return h ? h.Num(eff, key) : 0;
	}
	static string NumSrc(string eff, string key)
	{
		let h = H();
		return h ? h.NumSrc(eff, key) : "";
	}

	// the LegenDoom slot (0..8) of a BD22 / BD22 VR gun; an off-hand copy RSQ_Off_<Gun> counts as its gun
	static int SlotOf(Weapon w)
	{
		let h = H();
		return h ? h.SlotOf(w) : -1;
	}

	static string EffectOf(PlayerPawn mo, int slot)
	{
		let h = H();
		if (!h || !mo || slot < 0) return "";
		return h.EffName(mo.PlayerNumber(), slot);
	}

	// THE PASSIVES COUNTER. Owner, round 3 (Q9): "only the legendary gun IN HAND gives its passive (not every owned one)".
	// Copies of an effect on the slots of the guns in the player's hands: the main hand's, and the off hand's when
	// rsld_offhand_legendary is on (a slot counts once). LegenDoom's own rule (LD_CountEffect, LEGENDFNC.acs:69: every
	// owned legendary) is CountOwned.
	static int Count(Actor mo, string eff)
	{
		let p = PlayerPawn(mo);
		if (!p || !p.player) return CountOwned(mo, eff);
		int n = 0;
		int s0 = SlotOf(p.player.ReadyWeapon), s1 = -1;
		cvar oc = cvar.FindCvar("rsld_offhand_legendary");
		if (!oc || oc.GetBool()) s1 = SlotOf(RSLD_Handler.HandWeapon(p, OFF));	// round 4: the off hand's free fist is the Fists slot
		for (int k = 0; k < 2; k++)
		{
			int s = k == 0 ? s0 : s1;
			if (s < 0 || (k == 1 && s == s0)) continue;
			class<Inventory> c = "LD" .. RSLD_Data.Slots[s] .. "Effect_" .. eff;
			if (c && mo.CountInv(c) > 0) n++;
			else { let h = H(); if (h && h.EffName(p.PlayerNumber(), s) ~== eff) n++; }	// a rig-probe-forced effect
		}
		return n;
	}
	// is this slot's gun in one of the player's hands (Count's rule)
	static bool HeldSlot(Actor mo, int s)
	{
		let p = PlayerPawn(mo);
		if (!p || !p.player || s < 0) return false;
		if (SlotOf(p.player.ReadyWeapon) == s) return true;
		cvar oc = cvar.FindCvar("rsld_offhand_legendary");
		return (!oc || oc.GetBool()) && SlotOf(RSLD_Handler.HandWeapon(p, OFF)) == s;
	}
	// copies of an effect the player owns over all nine slots (LegenDoom's LD_CountEffect): effects that count
	// owned legendaries by their own rule (Thematic) and the Upgrading meter
	static int CountOwned(Actor mo, string eff)
	{
		int n = 0;
		for (int s = 0; s < 9 && mo; s++)
		{
			class<Inventory> c = "LD" .. RSLD_Data.Slots[s] .. "Effect_" .. eff;
			if (c && mo.CountInv(c) > 0) n++;
		}
		return n;
	}

	// target groups of LegenDoom's x3 effects (its descriptions name the monsters; LegenDoom's own monsters carry
	// the DamageFactor). BD22/XMVE monsters are matched by the vanilla class they derive from or replace, then by name.
	static bool InGroup(Actor t, string e)
	{
		if (!t) return false;
		let h = H();
		return h ? h.InGroup(t, e) : false;
	}

	static string HandName(int hand) { return hand == OFF ? "off" : "main"; }

	// round 2 (owner 2026-11-06): LegenDoom's OWN visual for an effect, from the loaded LegenDoom pk3 by class name
	// (never copied into BD22 VR). The actor is spawned and put straight into its visual state `label`, `skip` states
	// further on (past LegenDoom's damage and its own sound calls), before its first tic: its Spawn state (and any
	// A_Explode there) never runs. Its quakes are off (LD mode sets LegenDoom's LD_quakes off: handler.zs NoQuakes).
	static Actor LDVisual(string cls, Vector3 at, statelabel label, int skip = 0, Actor owner = null)
	{
		class<Actor> c = AC(cls);
		if (!c) return null;
		let a = Actor.Spawn(c, at, NO_REPLACE);
		if (!a) return null;
		a.target = owner;
		a.bNOINTERACTION = true;	// a visual: never touches anything
		State st = a.FindState(label);
		for (int i = 0; i < skip && st; i++) st = st.NextState;
		if (!st) { a.Destroy(); return null; }
		a.SetState(st);
		return a;
	}

	// BD22's rescued / allied marines (owner 2026-11-06 round 2: they count as teammates for the co-op effects):
	// alive, FRIENDLY, of BD22's Marine_Rifle family (brutal22test6 PlayerClasses/Marines.dec:107: every rescued or
	// placed marine, Marine_Shotgun / _Minigun / _Rocket / _PlasmaGun / _BFG, HeavyMachinegunMarine, derive from it;
	// a CapturedMarine freed becomes one, CapturedMarine.dec:140), within ALLY_RADIUS of the player.
	const ALLY_RADIUS = 1024;	// "near you": the owner's pick (round 2 report question; 1024 = LegenDoom's Sensing radius)
	static int AllyCount(Actor p) { Array<Actor> l; return Allies(p, l); }
	static int Allies(Actor p, out Array<Actor> found)
	{
		found.Clear();
		class<Actor> mc = AC("Marine_Rifle");
		if (!p || !mc) return 0;
		int n = 0;
		let it = BlockThingsIterator.Create(p, ALLY_RADIUS);
		while (it.Next())
		{
			let a = it.thing;
			if (!a || a == p || a.health <= 0 || !a.bFRIENDLY || !(a is mc) || p.Distance2D(a) > ALLY_RADIUS) continue;
			n++;
			found.Push(a);
		}
		return n;
	}
}

// One LegenDoom effect. Name the class RSLD_Fx_<LegenDoomName>; the handler makes one instance of every subclass.
class RSLD_Effect play
{
	string name;		// LegenDoom's effect name (from the class name)
	bool passive;		// Owned() is called every tic while the player owns this effect in any slot
	bool anyPickup;		// (Agent B) OnPickup / Owned also for players who do NOT own it (copies 0): LegenDoom's
						// LD_AnyPlayerHasEffect sharing effects (Quartermaster, Armorer, Medic, Shaman)
	RSLD_Handler h;

	virtual void Init() {}
	virtual void OnPull(RSLD_Shot s) {}
	virtual bool OnPellet(RSLD_Shot s, RSLD_Pellet p) { return false; }
	virtual void OnMissile(RSLD_Shot s, Actor m) {}
	virtual void OnMelee(RSLD_Shot s, Actor strike) {}
	virtual void ModifyDamage(RSLD_Shot s, RSLD_Hit hit) {}
	virtual void OnHit(RSLD_Shot s, RSLD_Hit hit) {}
	virtual void OnKill(RSLD_Shot s, RSLD_Hit hit) {}
	virtual void AfterPull(RSLD_Shot s) {}
	virtual void WhileHeld(RSLD_Held c) {}
	virtual void Owned(PlayerPawn p, int copies) {}
	virtual void OnMapStart(PlayerPawn p, int copies) {}
	virtual bool OnPickup(PlayerPawn p, Inventory item, int copies) { return false; }
	virtual void OnProbe(RSLD_Shot s) {}
	// (Agent B, Stealth) a BD22 alert helper missile (Alerter, DistantFireSound*) spawned in a pull of this gun:
	// return true and the handler destroys it
	virtual bool OnAlerter(RSLD_Shot s, Actor a) { return false; }
	// a pellet's result (RSLD.RES_*), every pellet of the pull incl. FirePellet / FireRail; True Bullets: when the
	// round arrives. at = where it ended (the puff spot), thing = what it damaged (or null)
	virtual void OnPelletEnd(RSLD_Shot s, RSLD_Pellet p, int res, Vector3 at, Actor thing) {}
	// every pellet of the pull has ended (or 128 tics passed: the rest end as RES_NONE)
	virtual void OnPullEnd(RSLD_Shot s) {}

	double Num(string key) { return h ? h.Num(name, key) : 0; }
	void Log(string s) { if (RSLD.Debug()) Console.Printf("RSLD %d %s: %s", level.maptime, name, s); }
}

// One trigger pull: every shot event of one hand in one tic.
class RSLD_Shot play
{
	PlayerPawn mo;
	int pn, hand, slot, rarity, tic, pull;
	Weapon weapon;
	RSLD_Effect fx;
	string effName;
	bool melee;
	int pellets, missiles, hits, kills;
	int ammoTaken, magTaken, resTaken;
	int preMag, preRes;		// the hand's gun's magazine / reserve at the start of the tic
	bool afterDone;
	// scratch for the effect that owns the pull
	bool b1, b2;
	int i1, i2;
	double d1, d2;
	// the gun's aim for this pull, taken at its first pellet: mo.angle and A_FireBullets' own bslope
	// (BulletSlope with the hand's ALF_ISOFFHAND: autoaim when the gun has it, else the pitch)
	double aimAngle, aimPitch;
	bool aimSet;
	int lastTic;			// the pull's last tic (a pump volley runs over two tics: handler PullOf)
	int recsOpen, recsTotal;
	bool endDone;

	void Log(string s)
	{
		if (RSLD.Debug())
			Console.Printf("RSLD %d %s p%d %s %s: %s", level.maptime, effName, pull, RSLD.HandName(hand), weapon ? weapon.GetClassName() : 'none', s);
	}

	// a BD22 / BD22 VR sound on the shooter (never a LegenDoom one: owner 11-06)
	void Sound(string snd, double vol = 1.0)
	{
		if (mo) mo.A_StartSound(snd, CHAN_AUTO, CHANF_OVERLAP, vol);
	}

	// give n rounds back to the pool this pull took them from: the magazine first (owner Q7), else the reserve.
	// Legal at any time after the pull (OnPelletEnd, OnPullEnd too).
	void Refund(int n)
	{
		if (n <= 0 || !weapon) return;
		Inventory mag = (weapon.Ammo2 && weapon.Ammo2 != weapon.Ammo1) ? weapon.Ammo2 : null;
		Inventory res = weapon.Ammo1;
		int toMag = 0, toRes = 0;
		if (magTaken > 0 && mag) toMag = n;
		else if (res) toRes = n;
		else if (mag) toMag = n;
		if (toMag) RSLD.AddAmmo(mag, toMag);
		if (toRes) RSLD.AddAmmo(res, toRes);
		Log(String.Format("refund %d -> %s", n, toMag ? mag.GetClassName() : (res ? res.GetClassName() : 'none')));
	}

	// take n from the same pool (magazine first), never below 0
	void Take(int n)
	{
		if (n <= 0 || !weapon) return;
		Inventory mag = (weapon.Ammo2 && weapon.Ammo2 != weapon.Ammo1) ? weapon.Ammo2 : null;
		Inventory res = weapon.Ammo1;
		Inventory pool = (magTaken > 0 && mag) ? mag : (res ? res : mag);
		if (!pool) return;
		int k = min(n, pool.Amount);
		pool.Amount -= k;
		Log(String.Format("take %d <- %s", k, pool.GetClassName()));
	}

	// an extra hitscan pellet of this pull, same hand (marked as ours: no new pull, no OnPellet; it gets its
	// OnPelletEnd). range 0 = PLAYERMISSILERANGE. It goes through muzzle / True Bullets / recoil as a shot event.
	void FirePellet(double angle, double pitch, int damage, class<Actor> puff, double range = 0, int flags = 0)
	{
		let hh = RSLD.H();
		if (hh && mo) hh.Refire(self, angle, pitch, damage, puff, flags, range > 0 ? range : PLAYERMISSILERANGE);
	}

	// a piercing rail of this pull (Gauss): mo.RailAttack with the angle/pitch as offsets from the body, no trail,
	// RGF_SILENT, RGF_ISOFFHAND for the off hand; muzzle.zs turns it onto the drawn barrel. One OnPelletEnd per rail:
	// RES_MONSTER if it damaged a monster, RES_THING another thing, else RES_WALL.
	// trail (round 2, LegenDoom's own rail look): color1 / color2 as A_RailAttack's (-1 none), duration, sparsity, drift
	void FireRail(double angle, double pitch, int damage, class<Actor> puff, double range = 0, int color1 = -1, int color2 = -1,
		int duration = 0, double sparsity = 1.0, double drift = 1.0)
	{
		let hh = RSLD.H();
		if (hh && mo) hh.FireRail(self, angle, pitch, damage, puff, range, color1, color2, duration, sparsity, drift);
	}

	// round 2: a projectile this pull fires instead of a pellet (Plasmatic, Gyrojet): tagged to the pull, so its damage
	// is this pull's (a LegenDoom class is otherwise taken for LegenDoom's own effect damage)
	void TagMissile(Actor m)
	{
		let hh = RSLD.H();
		if (hh && m) { missiles++; hh.Tag(m, self); }
	}
}

class RSLD_Pellet play
{
	double angle, pitch, aimAngle, aimPitch, spreadMul, range;
	int damage, flags;
	int index;			// 0-based index of this ORIGINAL pellet in its pull (-1 for FirePellet / FireRail pellets)
	bool rail;
	class<Actor> puff;
	Name damageType;
}

class RSLD_Hit play
{
	Actor target, inflictor;
	int damage, setDamage, flags;
	Name damageType;
	double mult;
	bool killed;
}

class RSLD_Held play
{
	PlayerPawn mo;
	int pn, hand, slot, rarity, idle;
	bool attacking;
	Weapon weapon;
	RSLD_Effect fx;
}

// a generated table of LegenDoom numbers (numbers_*.zs): rows "effect|key|value|source|text"
class RSLD_NumberTable play
{
	virtual int Count() { return 0; }
	virtual string Row(int i) { return ""; }
}

// Held by every player in LD mode: outgoing damage and pickups go through the handler
class RSLD_Amp : Inventory
{
	Default
	{
		+INVENTORY.UNDROPPABLE
		+INVENTORY.UNTOSSABLE
		+INVENTORY.UNCLEARABLE
		+INVENTORY.QUIET
		Inventory.MaxAmount 1;
	}

	override void ModifyDamage(int damage, Name damageType, out int newdamage, bool passive, Actor inflictor, Actor source, int flags)
	{
		if (passive || !Owner || !Owner.player || damage <= 0) return;
		let h = RSLD.H();
		if (h) newdamage = h.Outgoing(PlayerPawn(Owner), damage, damageType, inflictor, source, flags);
	}

	override bool HandlePickup(Inventory item)
	{
		let h = RSLD.H();
		if (h && Owner && Owner.player && h.Pickup(PlayerPawn(Owner), item)) return true;
		return Super.HandlePickup(item);
	}
}

// one pellet in flight (the handler resolves it from WorldHitscanFired / the round's delivery / the rail call)
class RSLD_PelletRec play
{
	RSLD_Shot s;
	RSLD_Pellet p;
	Actor thing;
	bool monster, ended, carried;
}
