		  defCls.Push("Rocket_Launcher"); defs.Push(d); }	// rocket_rpg
		{ let d = new("RSQ_RecoilDef");
		  d.rise = 7.000; d.riseTics = 8; d.climb = 2.200;
		  d.drift = 0.300; d.driftPeriod = 5;
		  d.recover = 22.000; d.delay = 6;
		  d.maxPitch = 7.000; d.maxYaw = 3.000;
		  defCls.Push("RailGun"); defs.Push(d); }	// rail
		{ let d = new("RSQ_RecoilDef");
		  d.rise = 5.000; d.riseTics = 8; d.climb = 0.940;
		  d.drift = 0.550; d.driftPeriod = 4;
		  d.recover = 16.000; d.delay = 6;
		  d.maxPitch = 5.100; d.maxYaw = 3.000;
		  defCls.Push("Rifle"); defs.Push(d); }	// rifle
		{ let d = new("RSQ_RecoilDef");
		  d.rise = 4.000; d.riseTics = 8; d.climb = 0.060;
		  d.drift = 0.200; d.driftPeriod = 5;
