// RS VR hands / reload / ballistics. Options: RSQ_Options in MENUDEF.rsq. v9.
user bool rsq_hands = true;			// VR hands on the controllers
user int rsr_reload = 1;			// Reloading: 1 VR (zscript/rsr, on the guns that have it; the rest stock), 0 stock
user bool rsq_reload_nonstd = true;	// 1.99x: Reload Non-Standard Guns -- the guns Brutal Doom gives no reload (zscript/rsq/counters.zs GUN[]); off = Brutal Doom's own
server int rsq_ballistics = 1;	// 1.97 F5: 0 Stock (BD22), 1 Low, 2 Max; 2.0.4j (owner 11-12 03:41: "enhanced ballistics default on"): Low is the default
server int rsq_ballistics_cfg = 0;	// 2.0.4j: 1 once a config saved under the old default (Stock) has been moved to Low (ballistics.zs WorldLoaded)	// enhanced impacts and projectile trails (server: they use playsim random)
user int rsq_punch = 0;			// VR punching: a real punch with either fist lands (zscript/rsq/fists.zs)
// 2026-10-23: a punch that lands on a switch or any usable line works it, at the fist's own reach
// instead of the engine's 64-unit use range. The LINE'S SPECIAL decides, not its texture.
user bool rsq_punch_use = true;
user bool rsq_no_trigger_punch = true;	// 2.0.3y (owner 11-06): in VR, BD22's fists throw no canned punch on trigger / alt fire; swing to punch (fists.zs RSQ_NoTrigPunch)
server bool rsq_extra_weapons = false;	// cheats also give the MP40, MG42, Devastator, Hellish launcher, flame cannon, incendiary launcher (zscript/nosniper)
user int rsr_grab_with = 0;		// 1.17 Grab ammo with: 0 off trigger, 1 off grip (1.14 rule), 2 Use key (only while a reload has the hand)
user bool rsq_flick = true;		// 1.17 Flick to reload: a gun in each hand, snap a barrel down to reload that gun (zscript/rsq/flick.zs)
// 2026-10-23: the VR scopes (zscript/rsq/scope.zs). Per gun, 0 DOT (a collimated red dot on
// the gun's own glass, no magnification) or 1 REAL (the view down the bore rendered into it).
// RSQ_ScopeTable.ModeCVar() maps the table index to these names, so a new scoped gun needs a
// row in that table and a cvar here and nothing else.
// 2.0 (owner 2026-10-28, "the real-time scope renders 3x at all times"): both default to Real 3x.
// Renamed from rsq_scope_sniper / rsq_scope_railgun: those are archived, so a 0 saved by an older
// build (the rig's ini held railgun 0; the owner's menu showed Dot on both) would have kept the
// scope at 1x on top of the new default. New names start at the new default on every ini.
user int rsq_scope2_sniper = 1;
user int rsq_scope2_railgun = 1;

// 1.97: roster
server bool rsq_mg_replaces_mg42 = false;	// every MG42 spawn is the BD21 Machinegun
// owner 2026-10-27 20:45, zscript/rsq/roster.zs: the Moonlight (BrutalRevolver) takes the Brutal Pistol's place
// everywhere (start, map pistols, the pistol zombie's drop); its rounds spawn on maps only while this is on.
// Start With Two: a new game starts with both Moonlights in hand (needs the first). Off: BD22's own start.
server bool rsq_moonlight_pistol = false;
server bool rsq_moonlight_two = false;

// owner 2026-10-27 20:47: HUD Ammo. 0 Magazine + Reserve (the held gun's magazine and its reserve), 1 Reserve Only.
// zscript/rsq/counters.zs RSQ_Counters.Hud sets what SBARINFO.rsq draws.
user int rsq_hud_ammo = 0;

// 2.0.2 (owner r3 item 39): "Pistol Whip" -- swing a pistol or revolver into something and it strikes (zscript/rsvr/melee.zs).
// The 1.97 kick-key gun bash (rsq_bash) is removed: the kick key is BD22's boot again.
user bool rsq_pistol_whip = true;
// the melee hit flash (zscript/rsq/bash.zs RSQ_BashFX), drawn on every melee hit
user bool rsq_bash_flash = true;	// 2.0.3d (owner 21:53): the melee hit flash On / Off
user int rsq_bash_fx = 0;		// which RS_CombatFX impact
user int rsq_bash_tint = 0;		// recolours the RSH0 flash only; 0 is the art as drawn

// 1.97: the two-handed butt strike. OFF by default: of the three melee moves this
// is the one most likely to misfire, because two hands on a rifle is the aiming
// posture, so it is the player's choice to turn on.
user int rsq_butt = 0;
user float rsvr_butt_fwd = 0.5;		// of the butt's speed that must point forward
user float rsvr_butt_lead = 1.3;	// 2.0.3y: no longer read (a straight shove counts too: melee.zs BUTT_LEAD)
user float rsq_butt_speed = 2.4;	// 2.0.3y (owner, BUGS_1.0 item 33): m/s at the stock a butt strike needs (was 3.6, fixed)

// 1.97 F5: per-gun recoil. Its own row, not the ballistics dial -- this costs one
// float a tic, the effects cost a frame budget, and they are not the same decision.
user int rsq_recoil = 1;

// 1.97 F6: the round in flight. 1.0 is RS_Ballistics' authored speed, which is
// 330 to 874 map units a tic -- a streak, because that is what a real round is.
// Lower to read it in the headset. It cannot change where anything lands: the
// hitscan has already hit by the time this is drawn.
user float rsq_round_speed = 1.0;

// 1.99 F7: the real casing meshes. Off = Brutal Doom's own sprites, sized per
// cartridge as 1.97 did. rsq_casing_size is a multiplier on true size: a 9mm case
// really is 19.2 mm, which is about 0.63 map units and may be small to see.
user bool rsq_casing_models = true;
user float rsq_casing_size = 1.0;
// 2.0.2a (owner 2026-10-28 19:47): Instant Weapon Switch (zscript/rsq/switch.zs). Off = BD22's raise / lower.
user bool rsq_instant_switch = true;
user int rsq_switch_log = 0;
// 2.0.3n: UNUSED. "Two-Hand Aim" (2.0.3k-2.0.3m, a script gun turn at tic rate) is removed: the owner's headset found it lagged
// behind the hands. Two-handing is the engine's own Two-Hand Grip (vr_two_handed_weapons). The cvar stays declared only so a
// saved ini line for it causes no error; nothing reads it.
user bool rsq_twohand_rifle = false;
user bool rsq_hud_nohp = false;   // the HUD draws no health or armour (owner 2026-11-12 15:36; the row is in RSQ Gun Cards' options)
user bool rsq_hud_noammo = false; // the HUD draws no ammo counts or ammo icons (owner 2026-11-13; the row is in RSQ Gun Cards' options: the cards show them)
