// LD mode (LegenDoom 3.0 x BD22 VR): zscript/rsld. Only read when LegenDoom 3.0 is loaded.
// LEGENDARY ECONOMY (2.0.5w, owner 2026-11-25: "an option in bd22 near the top that says Legendary Economy: On / Off, which
// would control the appearance of gold, kiosks and just allow for normal legendoom behavior"). On: gold bits (RSQ
// VisualRewards), the Boss and Big Boss kiosks (RSQ Miniboss), legendary weapons only from Bosses. Off: no gold, no kiosk,
// LegenDoom drops its legendary weapons as it ships. The other mods read it by name (absent: on).
server bool rsq_ld_economy = true;
server bool rsld_reroll = true;			// 2.0.5n: no longer read and no menu row (kept so a saved config still loads): an effect that is not applied is always re-rolled
user bool rsld_screen_name = false;		// the held gun's legendary name at the top of the view (owner 11-05: off; RSQ Wheel's card names it)
server bool rsld_tier_rarity = true;		// 2.0.4k: a Bossfight's legendary drop has its rarity rolled by the fight's tier (rarer = less likely, a higher tier eases it)
server bool rsld_champion_drops = false;	// 2.0.4x (owner 11-13): a boosted legendary dormant champion (outside a miniboss fight) drops its legendary weapon; off: only the miniboss does
server bool rsld_bossfight_only = true;		// with Champions and RSQ Miniboss's Bossfights: legendary weapons drop only from a Bossfight
server bool rsld_offhand_legendary = true;	// scope Q8 (OPEN): an off-hand copy of a legendary gun carries that slot's legendary too (on, as
						// the patch did: every shot got the held slot's effect); off = main hand only
server bool rsld_slug_primary = true;		// Agent C (scope Q12 open): LegenDoom's Slug replaces the pump/SSG's primary fire only; BD22 VR's
						// Slug alt fire stays as it ships. Off = Slug is not applied (re-rolled)
server noarchive int rsld_debug = 0;		// 1: what each effect did; 2: every hook call
server bool rsld_mute_ld_sounds = false;	// round 3 (owner): LegenDoom's non-gun sounds (legendary pickup jingles, the legendary-monster
						// aura) muted; off = they play as LegenDoom's (zscript/rsld/ldsounds.zs, SNDINFO.rsld). Round 4: on also
						// brings back QuestZDoom's own menu and info-screen sounds (ldsounds.zs RSLD_MenuDelegate, InfoTick)
