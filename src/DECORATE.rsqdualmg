// 2.0.5e GENERATED by tools/dual_minigun/gen_off_minigun.py from actors/Weapons/Minigun.dec. Do not edit by hand.
// The off-hand copy of BD22's Minigun (owner 2026-11-22: "The BD chaingun can be dual-wielded"), made as every copy in
// DECORATE.rsqdual is: the gun, renamed, its own magazine, the off hand only. Its own spin-up (RSQ_SpinOff), so each hand
// spins up on its own; the same shots, spread, damage and rate. See the script's header for every change.
ACTOR MinigunAmmoOff : Ammo
{
	Inventory.Amount 0
	Inventory.MaxAmount 200
	Ammo.BackpackAmount 0
	Ammo.BackpackMaxAmount 200
	+INVENTORY.IGNORESKILL
}

ACTOR RSQ_SpinOff : Inventory
{
	Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
	+INVENTORY.UNTOSSABLE
}

ACTOR RSQ_Off_Minigun : MiniGun
{
	Tag "Off-hand Minigun"
	Weapon.AmmoGive1 0
	Weapon.AmmoGive2 0
	Weapon.SelectionOrder 99999
	+WEAPON.OFFHANDWEAPON
	-WEAPON.NOHANDSWITCH	// it passes between hands; in the main hand it becomes its gun (dual.zs Hands)
	+WEAPON.CHEATNOTWEAPON

	Weapon.AmmoType1 "RSQ_MinigunAmmo"
	Weapon.AmmoType2 "MinigunAmmoOff"
	Weapon.AmmoUse2 0
	-INVENTORY.UNDROPPABLE
	Inventory.PickupSound "CBOXPKUP"
	Inventory.PickupMessage "$BDGOTCHAINGUN"
	Obituary "$OBBD_CHAINGUN"
	States
	{
	Reload:		// gen_off_minigun.py: the magazine tops up from the pouch (zscript/rsq/counters.zs OffFill)
		"####" "#" 0 A_JumpIfInventory("MinigunAmmoOff", 0, "Ready")	// full
		"####" "#" 0 A_JumpIfInventory("RSQ_MinigunAmmo", 1, "RSQ_OffFill")
		Goto Ready	// nothing in the pouch
	RSQ_OffFill:
		"####" "#" 0 A_PlaySound("Chaingun/beltQuiet", 5)
		"####" "#" 8 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		"####" "#" 0 A_GiveInventory("RSQ_OffFillMinigun", 1)
		"####" "#" 0 A_PlaySound("Chaingun/belt", 5)
		"####" "#" 8 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB)
		Goto Ready
	Spawn:
		MGUN A 1
		MGUN A -1
		Stop

	KickFlash: 
		CHAE A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, 2)
		CHAG A 0
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		"####" A 0 A_JumpIfInventory("RSQ_SpinOff",1,"SpinKickFlash")
		"####" HIJK 1
		"####" L 10
		"####" KJIH 1
		stop
	SlideFlash: 
		CHAE A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, 2)
		CHAG A 0
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		"####" A 0 A_JumpIfInventory("RSQ_SpinOff",1,"SpinSlideFlash")
		"####" HIJK 1
		"####" L 35
		stop
	SlideFlashEnd: 
		CHAE A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, 2)
		CHAG A 0
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		"####" A 0 A_JumpIfInventory("RSQ_SpinOff",1,"SpinSlideFlashEnd")
		"####" L 5
		"####" KJIH 1
		stop
	SlideFlashEndEarly: 
		CHAE A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, 2)
		CHAG A 0
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,"PuristKickFlash")
		"####" A 0 A_JumpIfInventory("RSQ_SpinOff",1,"SpinSlideFlashEndEarly")
		"####" L 2
		"####" KJIH 1
		stop

	SpinKickFlash: 
		"####" A 0 A_PlaySound("Chaingun/Spin", 1)
		"####" MNOP 1
		"####" QRSTQRSTQR 1//L 10
		"####" A 0 A_PlaySound("Chaingun/Spin", 1)
		"####" PONM 1
		TNT1 A 0 A_StopSound(1)
		stop
	SpinSlideFlash: 
		"####" A 0 A_PlaySound("Chaingun/Spin", 1)
		"####" MNOP 1
		"####" L 10
		"####" A 0 A_PlaySound("Chaingun/Spin", 1)
		"####" L 25
		TNT1 A 0 A_StopSound(1)
		stop
	SpinSlideFlashEnd: 
		"####" RSTQR 1
		"####" A 0 A_PlaySound("Chaingun/Spin", 1)
		"####" PONM 1
		TNT1 A 0 A_StopSound(1)
		stop
	SpinSlideFlashEndEarly: 
		"####" QR 1
		"####" A 0 A_PlaySound("Chaingun/Spin", 1)
		"####" PONM 1
		TNT1 A 0 A_StopSound(1)
		stop

	FirstSelectAnimation:
		TNT1 A 0 A_TakeInventory("NeverSelectedMinigun",1)
		CHAE UVWX 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Chaingun/beltQuiet", 5)
		CHAS ABCDEE 1 A_WeaponReady(WRF_ALLOWZOOM)
		TNT1 A 0 A_PlaySound("Chaingun/belt", 5)
		CHAS FFFGHIJLMNOOOPQRST 1 A_WeaponReady(WRF_ALLOWZOOM)
		Goto Ready

	Select:
		TNT1 A 0 A_Giveinventory("GoSpecial",1)
		TNT1 A 0 A_GiveInventory("TokenCleaner")
		TNT1 A 0 A_Giveinventory("HeavyAutomaticWeapon",1)
		TNT1 A 0 A_GiveInventory("RandomHeadExploder", 1)
		TNT1 A 0 A_SetCrosshair( CallACS("GetCrosshair", 6) )
		TNT1 A 0 A_GunFlash
		TNT1 A 1
		TNT1 A 0 A_Giveinventory("MinigunSelected",1)
		TNT1 A 0 A_PlaySound("CHGNPKUP", 5)
		TNT1 A 0 A_TakeInventory("NeverSelectedMinigun", 1)	// posefix: was TNT1 A 0 A_JumpIfInventory("NeverSelectedMinigun", 1,"FirstSelectAnimation")
		
	SelectAnimation:
		CHAE A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, 2)
		CHAG A 0
		"####" A 0 A_JumpIfInventory("IsPlayingAsPurist",1,"SelectPurist")
		"####" UVWX 1 A_WeaponReady(WRF_NOFIRE)
	Ready:
	Ready3:
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		CHAG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		CHAG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		CHAG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		CHAG A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		CHAG A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		CHAG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		CHAE A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, 2)
		CHAG A 0
		"####" A 1 A_WeaponReady
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")	// posefix rsr: the reload key
		CHAG A 0 A_JumpIfInventory("RSQ_SpinOff",1,"Ready2")
		CHAG A 0 A_JumpIf((OverlayID() != 1000000 && CountInv("FiredPrimary") > 0) || (OverlayID() == 1000000 && (GetPlayerInput(INPUT_BUTTONS) & 67108864) != 0), "Fire")
		Loop

	Ready2:
		TNT1 A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		CHAG A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		CHAG A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		CHAG A 0 A_JumpIfInventory("TossGrenade",1,"TossGrenade")
		CHAG A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		CHAG A 0 A_PlaySound("Chaingun/Spin", 5)
		CHAE A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, 2)
		CHAG A 0
		"####" ACDE 1 A_WeaponReady
		"####" "#" 0 A_JumpIf(OverlayID() != 1000000 && CountInv("Reloading") > 0, "Reload")	// posefix rsr 1.99x: the reload key while spun up (Ready2 never read it)
		CHAG A 0 A_AlertMonsters
		Loop

	StartSprint:
		CHAE A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, 2)
		CHAG A 0
		"####" A 0 A_JumpIfInventory("UsedStamina", 40, "StopSprintTired")
		"####" HIJ 1 A_WeaponReady(WRF_NOFIRE)
		"####" A 0 A_Takeinventory("Zoomed",1)
		"####" A 0 A_Takeinventory("ADSmode",1)
		"####" A 0 A_ZoomFactor(1.0)	
	Sprinting:
		"####" K 0 offset(-9,32)
		//CHAG A 0 offset(-9,32) A_JumpIfInventory("IsStandingStill", 1, "Ready3")
		"####" A 0 offset(-9,32) A_JumpIfInventory("UsedStamina", 0, "StopSprint")
		"####" A 0 offset(-9,32) ACS_ExecuteAlways(852, 0, 0, 0, 0)//Makes player faster.
		"####" A 0 offset(-9,32) A_JumpIfInventory("PowerStrength", 1, 2)
		"####" A 0 offset(-9,32) A_GiveInventory("UsedStamina", 9)
		"####" A 0 offset(-9,32)
		"####" K 1 offset(-9,34) A_SetPitch(pitch -0.5)
		"####" K 1 offset(-6,36) A_SetPitch(pitch -0.5)
		"####" K 1 offset(-3,38) A_SetPitch(pitch -0.5)
		"####" K 1 offset(0,38) A_SetPitch(pitch -0.5)
		"####" K 1 offset(3,36) A_SetPitch(pitch -0.5)
		"####" K 1 offset(6,34) A_SetPitch(pitch -0.5)
		"####" K 1 offset(9,32) A_SetPitch(pitch -0.5)
		"####" A 0 offset(9,32) A_WeaponReady(WRF_NOBOB)
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" A 0 offset(-9,32) A_GiveInventory("UsedStamina", 9)
		"####" A 0 offset(9,33) A_SpawnItemEx("FootStep", 0, 0, 2, 0, 0, -4)
		"####" K 1 offset(9,34) A_SetPitch(pitch +0.5)
		"####" K 1 offset(6,36) A_SetPitch(pitch +0.5)
		"####" K 1 offset(3,38) A_SetPitch(pitch +0.5)
		"####" K 1 offset(0,38) A_SetPitch(pitch +0.5)
		"####" K 1 offset(-3,36) A_SetPitch(pitch +0.5)
		"####" K 1 offset(-6,34) A_SetPitch(pitch +0.5)
		"####" K 1 offset(-9,32) A_SetPitch(pitch +0.5)
		"####" A 0 offset(-9,32) A_WeaponReady(WRF_NOBOB)
		"####" A 0 offset(-9,32) A_JumpIfInventory("IsRunning", 1, "Sprinting")
		Goto StopSprint

	StopSprint:
		"####" JIH 1
		"####" A 0 A_JumpIfInventory("UsedStamina", 60, "StopSprintTired")
		"####" A 0 ACS_ExecuteAlways(853, 0, 0, 0, 0)//Makes player slower.
		Goto Ready

	Deselect:
		CHAG A 0 A_TakeInventory ("RSQ_SpinOff",1)
		CHAG A 0 A_TakeInventory("TossGrenade", 1)
		CHAG A 0 A_Takeinventory("HeavyAutomaticWeapon",1)
		CHAG A 0 A_TakeInventory("RandomHeadExploder", 1)
		CHAG A 0 SetPlayerProperty(0,0,0)
		CHAG A 0 A_JumpIfInventory("IsPlayingAsPurist",1,"DeselectPurist")
		CHAE A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, 2)
		CHAG A 0
		"####" "][" 1
		"####" ZY 1 
		"####" A 0 A_StopSound(5)
		"####" AAAAAAAAAAAAAAAAAA 0 A_Lower
		TNT1 A 1 A_Lower
		Wait

	HoldEmpty:
		CHAF A 0 A_JumpIfInventory("MinigunAmmoOff",1,"Hold")	// 2.0: own pool (was Clip2)
		CHAF A 0 A_PlaySound("Chaingun/Spin", 5)
		CHAF R 1 A_PlaySound("Weapon/Empty", 1)
		CHAF ST 1 
		CHAF R 1 A_PlaySound("Weapon/Empty", 1)
		CHAF ST 1 
		CHAF R 1 A_PlaySound("Weapon/Empty", 1)
		CHAF ST 1
		CHAF A 0 A_ReFire("HoldEmpty")
		Goto EndSpin

	HoldSpinEmpty:
		CHAF A 0 A_JumpIfInventory("MinigunAmmoOff",1,"HoldSpin")	// 2.0: own pool (was Clip2)
		CHAF A 0 A_PlaySound("Chaingun/Spin", 5)
		CHAF P 1 A_PlaySound("Weapon/Empty", 1)
		CHAF Q 1 
		CHAF P 1 A_PlaySound("Weapon/Empty", 1)
		CHAF Q 1
		CHAF P 1 A_PlaySound("Weapon/Empty", 1)
		CHAF Q 1 
		CHAF B 0 A_ReFire("HoldSpinEmpty")
		Goto Ready2

	RSLD_Jammed:	// LD mode: LegenDoom's Perfect jammed this hand (1 s): no shot, sound, flash or casing; the hand works as in Ready
		"####" "#" 1 A_WeaponReady(WRF_NOFIRE | WRF_NOBOB | WRF_ALLOWRELOAD)
		Goto Ready
	Fire:
		"####" "#" 0 A_JumpIf((OverlayID() == 1000000 && (CountInv("RSLD_JamOff") > 0 || CountInv("RSLD_G5BlockOff") > 0)) || (OverlayID() != 1000000 && (CountInv("RSLD_JamMain") > 0 || CountInv("RSLD_G5BlockMain") > 0)), "RSLD_Jammed")	// LD mode (round 2/3): Perfect's jam or a G5 trigger hold (Chargeup, Overkill) blocks the trigger (zscript/rsld/handler.zs, ld_g5_core.zs; never given without LegenDoom)
		CHAE A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, 2)
		CHAG A 0
		"####" A 0
		"####" A 0 A_JumpIfInventory("RSQ_SpinOff",1,"HoldSpin")
		"####" A 0 A_PlaySound("Chaingun/Start", 5)
		"####" A 0 BRIGHT A_FireCustomMissile("Alerter", 0, 0, 0, 0)
		"####" A 0 A_AlertMonsters
		"####" ABDF 1
		"####" A 0 A_StopSound(5)
	Hold:
		"####" "#" 0 A_JumpIf((OverlayID() == 1000000 && (CountInv("RSLD_JamOff") > 0 || CountInv("RSLD_G5BlockOff") > 0)) || (OverlayID() != 1000000 && (CountInv("RSLD_JamMain") > 0 || CountInv("RSLD_G5BlockMain") > 0)), "RSLD_Jammed")	// LD mode (round 2/3): Perfect's jam or a G5 trigger hold (Chargeup, Overkill) blocks the trigger (zscript/rsld/handler.zs, ld_g5_core.zs; never given without LegenDoom)
		CHAV A 0 A_JumpIfInventory("IsPlayingAsPurist", 1,2)
		CHAF A 0
		"####" A 0 A_JumpIfInventory("RSQ_SpinOff",1,"HoldSpin")
		"####" A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, "HoldEmpty")
		//Fire 1
		"####" "#" 0 A_JumpIf((OverlayID() == 1000000 && (CountInv("RSLD_JamOff") > 0 || CountInv("RSLD_G5BlockOff") > 0)) || (OverlayID() != 1000000 && (CountInv("RSLD_JamMain") > 0 || CountInv("RSLD_G5BlockMain") > 0)), "RSLD_Jammed")	// LD mode (round 2/3): Perfect's jam or a G5 trigger hold, before each shot of the 3-shot loop
		"####" "#" 0 A_Quake(2,2,0,12,"")
		"####" A 0 A_PlaySound("Chaingun/Fire", 1)
		"####" A 0 A_PlaySound("FARMGN", 6)
		"####" A 0 A_ZoomFactor(0.98)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle2",30,5,27)
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-2,2), 0, 0, -12, 0, random(-2,2))
		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM")
		"####" "#" 0 A_TakeInventory("MinigunAmmoOff", 1)	// the shot's round, from this hand's magazine
		"####" G 1 BRIGHT A_FireBullets(3, 2, -1, 20, "MachineGunBulletPuff", FBF_NORANDOM)
		"####" A 0 A_Firecustommissile("50CaseSpawn2",random(-2,2),0,0,-12,-18)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//tactical mode has muzzle climb
		"####" A 0 A_SetANgle(angle + random(-1, 1))
		"####" A 0 A_SetPitch(pitch-0.6)
		"####" A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		"####" HI 1
		"####" A 0
		"####" A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, "HoldEmpty")
		//fire 2
		"####" "#" 0 A_JumpIf((OverlayID() == 1000000 && (CountInv("RSLD_JamOff") > 0 || CountInv("RSLD_G5BlockOff") > 0)) || (OverlayID() != 1000000 && (CountInv("RSLD_JamMain") > 0 || CountInv("RSLD_G5BlockMain") > 0)), "RSLD_Jammed")	// LD mode (round 2/3): Perfect's jam or a G5 trigger hold, before each shot of the 3-shot loop
		"####" "#" 0 A_Quake(2,2,0,12,"")
		"####" A 0 A_PlaySound("Chaingun/Fire", 1)
		"####" A 0 A_PlaySound("FARMGN", 6)
		"####" A 0 A_ZoomFactor(0.98)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,27)
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-2,2), 0, 0, -12, 0, random(-2,2))
		"####" "#" 0 A_TakeInventory("MinigunAmmoOff", 1)	// the shot's round, from this hand's magazine
		"####" J 1 BRIGHT A_FireBullets(3, 2, -1, 20, "MachineGunBulletPuff", FBF_NORANDOM)
		"####" A 0 A_Firecustommissile("50CaseSpawn2",random(-2,2),0,0,-12,-18)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//tactical mode has muzzle climb
		"####" A 0 A_SetANgle(angle + random(-1, 1))
		"####" A 0 A_SetPitch(pitch-0.6)
		"####" A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		"####" KL 1
		"####" A 0
		"####" A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, "HoldEmpty")
		//fire 3
		"####" "#" 0 A_JumpIf((OverlayID() == 1000000 && (CountInv("RSLD_JamOff") > 0 || CountInv("RSLD_G5BlockOff") > 0)) || (OverlayID() != 1000000 && (CountInv("RSLD_JamMain") > 0 || CountInv("RSLD_G5BlockMain") > 0)), "RSLD_Jammed")	// LD mode (round 2/3): Perfect's jam or a G5 trigger hold, before each shot of the 3-shot loop
		"####" "#" 0 A_Quake(2,2,0,12,"")
		"####" A 0 A_PlaySound("Chaingun/Fire", 1)
		"####" A 0 A_PlaySound("FARMGN", 6)
		"####" A 0 A_ZoomFactor(0.98)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle3",30,5,27)
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-2,2), 0, 0, -12, 0, random(-2,2))
		"####" "#" 0 A_TakeInventory("MinigunAmmoOff", 1)	// the shot's round, from this hand's magazine
		"####" M 1 BRIGHT A_FireBullets(3, 2, -1, 20, "MachineGunBulletPuff", FBF_NORANDOM)
		"####" A 0 A_Firecustommissile("50CaseSpawn2",random(-2,2),0,0,-12,-18)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//tactical mode has muzzle climb
		"####" A 0 A_SetANgle(angle + random(-1, 1))
		"####" A 0 A_SetPitch(pitch-0.6)
		"####" A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		"####" NO 1
		"####" B 0 A_ReFire
		"####" A 0 A_JumpIfInventory("RSQ_SpinOff",1,"Ready2")
	EndSpin:
		CHAG A 0 A_PlaySound("Chaingun/Stop", 5)
		CHAG A 0 A_TakeInventory("RSQ_SpinOff",1)
		CHAE A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, 2)
		CHAG A 0
		"####" DFCDEACDE 1 A_ReFire("Hold")
		"####" A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" ABCDEF 1 A_WeaponReady(WRF_ALLOWZOOM)
		"####" A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" ABCDEF 1 A_WeaponReady(WRF_ALLOWZOOM)
		"####" A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" ABCDEF 2 A_WeaponReady(WRF_ALLOWZOOM)
		"####" A 0 A_JumpIfInventory("ExecuteDownedEnemy", 1, "DoExecution")
		"####" A 0 A_JumpIfInventory("IsRunning",1,"StartSprint")
		"####" A 0 A_JumpIfInventory("Salute1", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Salute2", 1, "Salute")
		"####" A 0 A_JumpIfInventory("Taunting",1,"Taunt")
		"####" ABCD 3 A_WeaponReady(WRF_ALLOWZOOM)
		"####" EF 4 A_WeaponReady(WRF_ALLOWZOOM)
		Goto Ready
	
	DM:
		"####" "#" 0 A_TakeInventory("MinigunAmmoOff", 1)	// the shot's round, from this hand's magazine
		"####" G 1 BRIGHT A_FireBullets(3, 2, -1, 20, "MachineGunBulletPuffDM", FBF_NORANDOM)
		"####" A 0 A_Firecustommissile("50CaseSpawn2",random(-2,2),0,0,-12,-18)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//tactical mode has muzzle climb
		"####" A 0 A_SetANgle(angle + random(-1, 1))
		"####" A 0 A_SetPitch(pitch-0.6)
		"####" A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		"####" HI 1
		"####" A 0
		"####" A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, "HoldEmpty")
		//fire 2
		"####" "#" 0 A_Quake(2,2,0,12,"")
		"####" A 0 A_PlaySound("Chaingun/Fire", 1)
		"####" A 0 A_PlaySound("FARMGN", 6)
		"####" A 0 A_ZoomFactor(0.98)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,27)
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-2,2), 0, 0, -12, 0, random(-2,2))
		"####" "#" 0 A_TakeInventory("MinigunAmmoOff", 1)	// the shot's round, from this hand's magazine
		"####" J 1 BRIGHT A_FireBullets(3, 2, -1, 20, "MachineGunBulletPuffDM", FBF_NORANDOM)
		"####" A 0 A_Firecustommissile("50CaseSpawn2",random(-2,2),0,0,-12,-18)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//tactical mode has muzzle climb
		"####" A 0 A_SetANgle(angle + random(-1, 1))
		"####" A 0 A_SetPitch(pitch-0.6)
		"####" A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		"####" KL 1
		"####" A 0
		"####" A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, "HoldEmpty")
		//fire 3
		"####" "#" 0 A_Quake(2,2,0,12,"")
		"####" A 0 A_PlaySound("Chaingun/Fire", 1)
		"####" A 0 A_PlaySound("FARMGN", 6)
		"####" A 0 A_ZoomFactor(0.98)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle3",30,5,27)
		"####" A 0 A_FireCustomMissile("DecorativeTracer", random(-2,2), 0, 0, -12, 0, random(-2,2))
		"####" "#" 0 A_TakeInventory("MinigunAmmoOff", 1)	// the shot's round, from this hand's magazine
		"####" M 1 BRIGHT A_FireBullets(3, 2, -1, 20, "MachineGunBulletPuffDM", FBF_NORANDOM)
		"####" A 0 A_Firecustommissile("50CaseSpawn2",random(-2,2),0,0,-12,-18)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_JumpIfInventory("IsNOTTacticalClass", 1, 3)//tactical mode has muzzle climb
		"####" A 0 A_SetANgle(angle + random(-1, 1))
		"####" A 0 A_SetPitch(pitch-0.6)
		"####" A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		"####" NO 1
		"####" B 0 A_ReFire
		"####" A 0 A_JumpIfInventory("RSQ_SpinOff",1,"Ready2")
		Goto EndSpin

	HoldSpin:
		//fire1
		"####" "#" 0 A_JumpIf((OverlayID() == 1000000 && (CountInv("RSLD_JamOff") > 0 || CountInv("RSLD_G5BlockOff") > 0)) || (OverlayID() != 1000000 && (CountInv("RSLD_JamMain") > 0 || CountInv("RSLD_G5BlockMain") > 0)), "RSLD_Jammed")	// LD mode (round 2/3): Perfect's jam or a G5 trigger hold, before each shot of the 3-shot loop
		CHAG A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, "HoldSpinEmpty")
		"####" "#" 0 A_Quake(2,2,0,12,"")
		CHAG A 0 A_PlaySound("Chaingun/Fire", 1)
		CHAG A 0 A_PlaySound("FARMGN", 6)
		CHAG A 0 A_ZoomFactor(0.98)
		CHAG A 0 A_SpawnItemEx("PlayerMuzzle2",30,5,27)
