		//"####" A 0 A_JumpIfInventory("DMgame", 1, "DM2")
		"####" "#" 0 A_TakeInventory("MinigunAmmoOff", 1)	// the shot's round, from this hand's magazine
		CHAF A 1 BRIGHT A_FireBullets(3, 2, -1, 20, "MachineGunBulletPuff", FBF_NORANDOM)
		HBUS A 0 A_Firecustommissile("50CaseSpawn2",random(-2,2),0,0,-12,-18)
		CHAG A 0 A_ZoomFactor(1.0)
		RIFG A 0 A_SetANgle(angle + random(-1, 1))
		RIFG A 0 A_SetPitch(pitch-0.6)
		CHAG A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		CHAF B 1
		CHAG A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, "HoldSpinEmpty")
		//fire2
		"####" "#" 0 A_JumpIf((OverlayID() == 1000000 && (CountInv("RSLD_JamOff") > 0 || CountInv("RSLD_G5BlockOff") > 0)) || (OverlayID() != 1000000 && (CountInv("RSLD_JamMain") > 0 || CountInv("RSLD_G5BlockMain") > 0)), "RSLD_Jammed")	// LD mode (round 2/3): Perfect's jam or a G5 trigger hold, before each shot of the 3-shot loop
		"####" "#" 0 A_Quake(2,2,0,12,"")
		CHAG A 0 A_PlaySound("Chaingun/Fire", 1)
		CHAG A 0 A_PlaySound("FARMGN", 6)
		CHAG A 0 A_ZoomFactor(0.98)
		CHAG A 0 A_SpawnItemEx("PlayerMuzzle1",30,5,27)
		CHAF A 0 A_FireCustomMissile("DecorativeTracer", random(-2,2), 0, 0, -12, 0, random(-2,2))
		"####" "#" 0 A_TakeInventory("MinigunAmmoOff", 1)	// the shot's round, from this hand's magazine
		CHAF C 1 BRIGHT A_FireBullets(3, 2, -1, 20, "MachineGunBulletPuff", FBF_NORANDOM)
		HBUS A 0 A_Firecustommissile("50CaseSpawn2",random(-2,2),0,0,-12,-18)
		CHAG A 0 A_ZoomFactor(1.0)
		RIFG A 0 A_SetANgle(angle + random(-1, 1))
		RIFG A 0 A_SetPitch(pitch-0.6)
		CHAG A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		CHAF D 1
		CHAG A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, "HoldSpinEmpty")
		//fire3
		"####" "#" 0 A_JumpIf((OverlayID() == 1000000 && (CountInv("RSLD_JamOff") > 0 || CountInv("RSLD_G5BlockOff") > 0)) || (OverlayID() != 1000000 && (CountInv("RSLD_JamMain") > 0 || CountInv("RSLD_G5BlockMain") > 0)), "RSLD_Jammed")	// LD mode (round 2/3): Perfect's jam or a G5 trigger hold, before each shot of the 3-shot loop
		"####" "#" 0 A_Quake(2,2,0,12,"")
		CHAG A 0 A_PlaySound("Chaingun/Fire", 1)
		CHAG A 0 A_PlaySound("FARMGN", 6)
		CHAG A 0 A_ZoomFactor(0.98)
		CHAG A 0 A_SpawnItemEx("PlayerMuzzle3",30,5,27)
		CHAF A 0 A_FireCustomMissile("DecorativeTracer", random(-2,2), 0, 0, -12, 0, random(-2,2))
		"####" "#" 0 A_TakeInventory("MinigunAmmoOff", 1)	// the shot's round, from this hand's magazine
		CHAF E 1 BRIGHT A_FireBullets(3, 2, -1, 20, "MachineGunBulletPuff", FBF_NORANDOM)
		HBUS A 0 A_Firecustommissile("50CaseSpawn2",random(-2,2),0,0,-12,-18)
		CHAG A 0 A_ZoomFactor(1.0)
		RIFG A 0 A_SetANgle(angle + random(-1, 1))
		RIFG A 0 A_SetPitch(pitch-0.6)
		CHAG A 0 A_JumpIfInventory("IsTacticalClass", 1, 2)//Tactical mode skips a frame, fires faster
		CHAF F 1
		CHAG A 0 A_JumpIf(CountInv("MinigunAmmoOff") < 1, "HoldSpinEmpty")
		CHAG A 0 A_ReFire("HoldSpin")
		Goto Ready2
	
	DM2:
