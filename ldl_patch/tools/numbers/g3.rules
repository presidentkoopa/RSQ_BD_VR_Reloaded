# --- Transmogrifier: out of its own ammo, the next kind in LegenDoom's order and its cost (<Gun>.dec FireTransmogrifierAmmoCheck)
Transmogrifier pi_Clip      decorate/Pistol/Pistol.dec                    re "(?s)\n\s*FireTransmogrifierAmmoCheck:(?:(?!Goto).)*?A_JumpIfInventory\(\"Clip\",\s*(\d+),"
# order pi 1 Clip
Transmogrifier pi_Shell     decorate/Pistol/Pistol.dec                    re "(?s)\n\s*FireTransmogrifierAmmoCheck:(?:(?!Goto).)*?A_JumpIfInventory\(\"Shell\",\s*(\d+),"
# order pi 2 Shell
Transmogrifier pi_Cell      decorate/Pistol/Pistol.dec                    re "(?s)\n\s*FireTransmogrifierAmmoCheck:(?:(?!Goto).)*?A_JumpIfInventory\(\"Cell\",\s*(\d+),"
# order pi 3 Cell
Transmogrifier pi_RocketAmmo decorate/Pistol/Pistol.dec                    re "(?s)\n\s*FireTransmogrifierAmmoCheck:(?:(?!Goto).)*?A_JumpIfInventory\(\"RocketAmmo\",\s*(\d+),"
# order pi 4 RocketAmmo
Transmogrifier sg_Shell     decorate/Shotgun/Shotgun.dec                  re "(?s)\n\s*FireTransmogrifierAmmoCheck:(?:(?!Goto).)*?A_JumpIfInventory\(\"Shell\",\s*(\d+),"
# order sg 1 Shell
