# --- Overflowing: maxed Rocket -> a small blast (puff / projectile), maxed Cell -> x1.5, maxed Shell -> a free extra volley
Overflowing  bul_aoe      decorate/EpicSpecialEffects.dec               re "(?s)ACTOR LDOverflowingAOEBulletPuff.*?A_Explode \((\d+),"
Overflowing  bul_aoerad   decorate/EpicSpecialEffects.dec               re "(?s)ACTOR LDOverflowingAOEBulletPuff.*?A_Explode \(\d+, (\d+),"
Overflowing  rk_aoe       decorate/EpicSpecialEffects.dec               re "(?s)ACTOR LDOverflowingAOERocket.*?A_Explode \((\d+),"
Overflowing  rk_aoerad    decorate/EpicSpecialEffects.dec               re "(?s)ACTOR LDOverflowingAOERocket.*?A_Explode \(\d+, (\d+),"
Overflowing  pl_aoe       decorate/EpicSpecialEffects.dec               re "(?s)ACTOR LDOverflowingAOEPlasmaBall.*?A_Explode \((\d+),"
Overflowing  pl_aoerad    decorate/EpicSpecialEffects.dec               re "(?s)ACTOR LDOverflowingAOEPlasmaBall.*?A_Explode \(\d+, (\d+),"
Overflowing  bfg_aoe      decorate/EpicSpecialEffects.dec               re "(?s)ACTOR LDOverflowingAOEBFGBall.*?A_Explode \((\d+),"
Overflowing  bfg_aoerad   decorate/EpicSpecialEffects.dec               re "(?s)ACTOR LDOverflowingAOEBFGBall.*?A_Explode \(\d+, (\d+),"
Overflowing  rk_cell      decorate/EpicSpecialEffects.dec               re "(?s)ACTOR LDOverflowingCellRocket.*?Damage (\d+)"
Overflowing  pl_cell      decorate/EpicSpecialEffects.dec               re "(?s)ACTOR LDOverflowingCellPlasmaBall.*?Damage (\d+)"
Overflowing  bfg_cell     decorate/EpicSpecialEffects.dec               re "(?s)ACTOR LDOverflowingCellBFGBall.*?Damage (\d+)"
Overflowing  bul_cell     decorate/Shotgun/Shotgun.dec                  re "(?s)FireOverflowingCell:.*?\(5 \* random\(1,3\)\) \* ([\d.]+)"
Overflowing  sg_n         decorate/Shotgun/Shotgun.dec                  re "(?s)FireOverflowing:.*?A_FireBullets \(5.6, 0, (\d+), 5,"
Overflowing  sg_extra     decorate/Shotgun/Shotgun.dec                  re "(?s)FireOverflowing:.*?A_FireBullets \(5.6, 0, \d+, 5, \"LDBulletPuff\", FBF_USEAMMO\).*?A_FireBullets \(5.6, 0, (\d+), 5,"
Overflowing  ss_n         decorate/SuperShotgun/SuperShotgun.dec        re "(?s)FireOverflowing:.*?A_FireBullets \(11.2, 7.1, (\d+), 5,"
Overflowing  ss_extra     decorate/SuperShotgun/SuperShotgun.dec        re "(?s)FireOverflowing:.*?A_FireBullets \(11.2, 7.1, \d+, 5, \"LDBulletPuff\", FBF_USEAMMO\).*?A_FireBullets \(11.2, 7.1, (\d+), 5,"
Optional     rk_expl    decorate/UncommonSpecialEffects.dec           re "(?s)ACTOR LDOptionalRocket.*?A_Explode \((\d+),"
Optional     rk_rad     decorate/UncommonSpecialEffects.dec           re "(?s)ACTOR LDOptionalRocket.*?A_Explode \(\d+, (\d+)\)"
Optional     bfg_rays   decorate/UncommonSpecialEffects.dec           re "(?s)ACTOR LDOptionalBFGBall.*?A_BFGSpray \(\"LDOptionalBFGFlash\", (\d+),"
Optional     bfg_raydmg decorate/UncommonSpecialEffects.dec           re "(?s)ACTOR LDOptionalBFGBall.*?A_BFGSpray \(\"LDOptionalBFGFlash\", \d+, (\d+)\)"
