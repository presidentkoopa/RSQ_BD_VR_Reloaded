Spamtastic   scale              decorate/RareSpecialEffects.dec               re "(?s)ACTOR LDSpamtasticRocket2.*?Scale ([\d.]+)"
# --- Recycling per gun: direct gives (Clip, Shell, Cell) and counters (C, 100 = one round: LDRecyclingAmmoGeneration)
Recycling    pi_ClipC   decorate/Pistol/Pistol.dec                    re "(?s)\n\s*FireRecycling:(?:(?!Goto).)*?A_GiveInventory \(\"LDRecyclingClipCounter\", (\d+)\)"
